{
  "version": 1,

  "splash": {
    "enabled": true,

    "background": {
      "type": "image",
      "imageUrl": "adsfhjkaldsf",
      "fit": "cover"
    },

    "loadingText": "Loading configuration...",
    "readyText": "Ready!"
  },

  "remoteControl": {
    "appEnabled": true,

    "maintenance": {
      "enabled": false,
      "title": "Maintenance",
      "message": "Server upgrade in progress. Please try again later."
    },

    "update": {
      "enabled": true,
      "force": false,
      "minVersionCode": 2,
      "latestVersionName": "1.0.1",
      "title": "Update Available",
      "message": "A newer version is available.",
      "androidStoreUrl": "https://play.google.com/store/apps/details?id=com.buffalo.fungames",
      "fallbackUrl": "https://your-site.com/download"
    }
  },

  "app": {
    "name": "King of Garuda",
    "title": "KING OF GARUDA",
    "subtitle": "Triple Match Game"
  },

  "home": {
    "background": {
    "type": "image",
    "useSplashBackground": true
  },
    "logoAsset": "garuda_logo",

    "buttons": [
      {
        "id": "play_game",
        "label": "PLAY GAME",
        "icon": "🎮",
        "visible": true,
        "action": {
          "type": "route",
          "route": "game1_match3"
        }
      },

   
      {
        "id": "exit_game",
        "label": "EXIT GAME",
        "icon": "https://i.pinimg.com/736x/d7/9f/2f/d79f2f05de6fc785cda188d851c9cd1d.jpg",
        "visible": true,
        "action": {
          "type": "exit"
        }
      }
    ]
  },

  "games": {
    "game1_match3": {
      "enabled": true,

      "title": "Fruit Match",

      "board": {
        "columns": 6,
        "rows": 9
      },

      "timer": {
        "enabled": true,
        "seconds": 80
      },

      "tray": {
        "maxItems": 7
      },

      "scoring": {
        "match3": 30,
        "levelBonus": 100
      },

      "shuffle": {
        "enabled": true,
        "maxAutoShuffle": 3
      },

      "level": {
        "enabled": true,
        "startLevel": 1,
        "maxLevel": 10
      }
    }
  }
}
